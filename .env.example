# Backend
PORT=4000
HOST=127.0.0.1
NODE_ENV=development
FRONTEND_ORIGIN=http://localhost:5173
# Required in production or when HOST is not 127.0.0.1; at least 24 characters.
# API_TOKEN=generate_a_long_random_secret

# Supabase PostgreSQL / PostGIS
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key
SUPABASE_ANON_KEY=your_anon_key
POSTGRES_HOST=your-session-pooler-host
POSTGRES_PORT=5432
POSTGRES_DB=postgres
POSTGRES_USER=postgres.your-project-ref
POSTGRES_PASSWORD=your_database_password
DATABASE_URL=postgresql://postgres.your-project-ref:encoded_password@your-session-pooler-host:5432/postgres
# Copy the actual session-pooler connection string from Supabase Connect (port 5432).
# URL-encode special password characters. Do not guess the pooler region/hostname.
DATABASE_LISTEN_URL=postgresql://postgres.your-project-ref:encoded_password@your-session-pooler-host:5432/postgres
DATABASE_SSL_MODE=verify-full
# DATABASE_CA_FILE=/absolute/path/to/root-ca.crt
# ALLOW_INSECURE_DB_TLS=false

# Future regional PostgreSQL schemas
POSTGRES_MAIN_SCHEMA=railway_main
POSTGRES_NORTH_SCHEMA=railway_north
POSTGRES_CENTRAL_SCHEMA=railway_central
POSTGRES_SOUTH_SCHEMA=railway_south

# Neo4j Aura
NEO4J_URI=neo4j+s://your-instance.databases.neo4j.io
NEO4J_USER=neo4j
NEO4J_PASSWORD=your_generated_password
NEO4J_DATABASE=neo4j
# Use the exact username and database supplied with your Aura instance credentials.
WORKER_ENABLED=true
WORKER_POLL_MS=2000

# Frontend
VITE_API_BASE_URL=http://localhost:4000/api
VITE_SOCKET_URL=http://localhost:4000
